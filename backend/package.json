{
  "name": "backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "test": "mocha tests/**/*.test.js --timeout 10000 --exit",
    "test:coverage": "nyc --reporter=text --reporter=text-summary --reporter=html mocha tests/**/*.test.js --timeout 10000 --exit",
    "start": "node server.js",
    "test:db": "node test-db.js"
  },
  "nyc": {
    "all": true,
    "include": [
      "routes/**/*.js",
      "data/memoryStore.js",
      "data/store.js",
      "data/db.js",
      "server.js",
      "loadEnv.js"
    ],
    "exclude": [
      "tests/**",
      "data/database.js",
      "data/mysqlStore.js",
      "data/seed.js",
      "test-db.js",
      "vercel.js"
    ],
    "check-coverage": true,
    "lines": 70,
    "statements": 70,
    "functions": 70,
    "branches": 60
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dependencies": "^0.0.1",
    "dotenv": "^17.4.1",
    "express": "^4.22.1",
    "express-validator": "^7.3.1",
    "mysql2": "^3.20.0"
  },
  "devDependencies": {
    "chai": "^6.2.2",
    "mocha": "^11.7.5",
    "nyc": "^18.0.0",
    "supertest": "^7.2.2"
  }
}
